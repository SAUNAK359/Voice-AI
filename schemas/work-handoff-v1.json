{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RizzlerWorkHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "session_id",
    "objective",
    "user_utterance",
    "context",
    "permissions",
    "deliverables",
    "constraints",
    "priority"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "objective": {
      "type": "string",
      "minLength": 3,
      "maxLength": 8000
    },
    "user_utterance": {
      "type": "string",
      "minLength": 3,
      "maxLength": 8000
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "conversation",
        "artifact_ids",
        "parent_job_id"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 5000
        },
        "conversation": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 3000
              }
            }
          }
        },
        "artifact_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "parent_job_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web_search",
        "dataset_read",
        "artifact_write",
        "automation_propose",
        "external_actions"
      ],
      "properties": {
        "web_search": {
          "type": "boolean"
        },
        "dataset_read": {
          "type": "boolean"
        },
        "artifact_write": {
          "type": "boolean"
        },
        "automation_propose": {
          "type": "boolean"
        },
        "external_actions": {
          "type": "boolean"
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": [
          "answer",
          "research",
          "data_analysis",
          "automation_plan",
          "csv",
          "docx",
          "html",
          "json",
          "md",
          "pdf",
          "png",
          "pptx",
          "svg",
          "txt",
          "xlsx",
          "zip"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline_utc",
        "max_wall_seconds",
        "max_tool_calls",
        "max_output_files",
        "sources_required"
      ],
      "properties": {
        "deadline_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 900
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_output_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "sources_required": {
          "type": "boolean"
        }
      }
    },
    "priority": {
      "enum": [
        "normal",
        "high"
      ]
    }
  }
}
