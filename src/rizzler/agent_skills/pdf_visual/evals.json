{
  "schema_version": 1,
  "agent": "pdf_visual",
  "checks": [
    {
      "id": "complete_sections",
      "required": true,
      "verification": "independent_fixture_or_runtime_check"
    },
    {
      "id": "legible_pagination",
      "required": true,
      "verification": "independent_fixture_or_runtime_check"
    },
    {
      "id": "no_raw_markdown",
      "required": true,
      "verification": "independent_fixture_or_runtime_check"
    },
    {
      "id": "no_ascii_diagram_leakage",
      "required": true,
      "verification": "independent_fixture_or_runtime_check"
    },
    {
      "id": "rendered_page_quality",
      "required": true,
      "verification": "independent_fixture_or_runtime_check"
    },
    {
      "id": "artifact_integrity",
      "required": true,
      "verification": "independent_fixture_or_runtime_check"
    }
  ],
  "release_thresholds": {
    "critical_failure_rate": 0,
    "regression_suite": "must_pass",
    "p95_latency": "measure_not_assume"
  },
  "limitations": "These are evaluation contracts, not claims that production benchmarks have passed."
}
