# Copy into local environment. Never commit secrets or put them in URLs.
RIZZLER_ACCESS_KEY=replace-with-a-private-long-random-secret
GEMINI_API_KEY=configure-in-your-environment
RIZZLER_GEMINI_MODEL=gemini-3.5-flash-lite
RIZZLER_ASR_MODEL=large-v3-turbo
RIZZLER_ASR_DEVICE=cpu
RIZZLER_TTS_MODEL=KittenML/kitten-tts-nano-0.8
RIZZLER_TTS_VOICE=Bruno
RIZZLER_HOST=127.0.0.1
RIZZLER_PORT=8000

# Phase 3 local governance. Do not commit real credentials.
RIZZLER_GEMINI_FALLBACK_MODELS=
RIZZLER_GEMINI_RPM=12
RIZZLER_GEMINI_TPM=24000
RIZZLER_GEMINI_MAX_ATTEMPTS=3
RIZZLER_GEMINI_QUOTA_WAIT=1.5
RIZZLER_GEMINI_ENABLE_THINKING=false
# Prices are deliberately unset; estimated USD is unknown without confirmed rates.
# RIZZLER_GEMINI_INPUT_USD_PER_MILLION=
# RIZZLER_GEMINI_OUTPUT_USD_PER_MILLION=

# Experimental V23 Work Agent cognition (opt-in; all default to 0)
# RIZZLER_COGNITIVE_PLANNER=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_COGNITIVE_CONTENT=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_COGNITIVE_REVIEW=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_EVIDENCE_FETCH=0  # optional override; omit to inherit RIZZLER_V23_MODE
# Strict QA requires LibreOffice/PyMuPDF; structural checks do not grade aesthetics.
RIZZLER_ARTIFACT_QA=structural

# V23 Cognitive Work Studio (experimental; default compatibility mode)
RIZZLER_V23_MODE=off
# RIZZLER_COGNITIVE_EXPERTS=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_RESEARCH_FRONTIER=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_CLAIM_VERIFY=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_V23_UNIFIED_RESEARCH=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_COGNITIVE_STUDIO=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_REPORT_STUDIO=0  # optional override; omit to inherit RIZZLER_V23_MODE
# RIZZLER_EXCEL_STUDIO=0  # optional override; omit to inherit RIZZLER_V23_MODE
RIZZLER_PROVIDER_SLOTS=3
# User memory requires separate explicit opt-in and key.

# Long-form Gemini Work calls may need a larger bounded timeout.
# RIZZLER_REQUEST_TIMEOUT=90
