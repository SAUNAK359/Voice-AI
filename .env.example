# Documentation ONLY; never copy actual values into the repository.
# Kaggle: configure these in Add-ons > Secrets.
GEMINI_API_KEY=<configured-in-kaggle-secrets>
RIZZLER_ACCESS_KEY=<a-private-random-value-at-least-16-characters>
# Optional Gemini Work Agent model selection: verify the model is available to your key.
RIZZLER_WORK_MODEL=<verified-gemini-model-id>
