# Copy into local environment. Never commit secrets or put them in URLs.
RIZZLER_ACCESS_KEY=replace-with-a-private-long-random-secret
RIZZLER_AGENTIC_ENABLED=1
# One private demo session for Voice + Work; no separate Work bearer token.
# For production use OIDC as configured in deploy/production.env.example.
GEMINI_API_KEY=configure-in-your-environment
RIZZLER_GEMINI_MODEL=gemini-3.5-flash-lite
RIZZLER_ASR_MODEL=large-v3-turbo
RIZZLER_ASR_DEVICE=cpu
RIZZLER_TTS_MODEL=KittenML/kitten-tts-nano-0.8
RIZZLER_TTS_VOICE=Bruno
RIZZLER_HOST=127.0.0.1
RIZZLER_PORT=8000

# Phase 3 local governance. Do not commit real credentials.
RIZZLER_GEMINI_FALLBACK_MODELS=
RIZZLER_GEMINI_RPM=12
RIZZLER_GEMINI_TPM=24000
RIZZLER_GEMINI_MAX_ATTEMPTS=3
RIZZLER_GEMINI_QUOTA_WAIT=1.5
RIZZLER_GEMINI_ENABLE_THINKING=false
# Prices are deliberately unset; estimated USD is unknown without confirmed rates.
# RIZZLER_GEMINI_INPUT_USD_PER_MILLION=
# RIZZLER_GEMINI_OUTPUT_USD_PER_MILLION=
