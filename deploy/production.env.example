# COPY TO .env.production AND REPLACE PLACEHOLDERS. NEVER COMMIT REAL VALUES.
# RIZZLER_DOMAIN is configured in the Compose shell, not here.
RIZZLER_OIDC_ISSUER=https://identity.example.com
RIZZLER_OIDC_AUTHORIZE_URL=https://identity.example.com/oauth2/authorize
RIZZLER_OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
RIZZLER_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
RIZZLER_OIDC_CLIENT_ID=replace-with-registered-client-id
RIZZLER_OIDC_CLIENT_SECRET=
RIZZLER_OIDC_REDIRECT_URI=https://rizzler.example.com/auth/callback
RIZZLER_SESSION_SIGNING_KEY=replace-with-independent-32plus-byte-random-secret
RIZZLER_WORK_SIGNING_KEY=replace-with-another-32plus-byte-random-secret
RIZZLER_OPERATIONS_TOKEN=replace-with-third-independent-32plus-byte-secret
GEMINI_API_KEY=configure-securely
RIZZLER_GEMINI_MODEL=gemini-3.5-flash-lite
RIZZLER_GEMINI_RPM=12
RIZZLER_GEMINI_TPM=24000
RIZZLER_ASR_DEVICE=cpu

# Optional PostgreSQL job ledger; configure with a managed instance or Compose database.
# RIZZLER_DATABASE_URL=postgresql://rizzler:SECRET@postgres:5432/rizzler
# Optional S3-compatible private object storage; credentials via IAM/workload identity.
# RIZZLER_S3_BUCKET=your-private-bucket
# RIZZLER_S3_REGION=ap-south-1
# RIZZLER_S3_ENDPOINT_URL=https://your-trusted-object-endpoint

# Required for production artifact verification. Rendering/calc failures refuse completion.
RIZZLER_ARTIFACT_QA=strict

# V11 Phase 3: optional rolling ASR is expensive; enable only on qualified runtime.
RIZZLER_INTERIM_ASR=0
# Optional model warmup; enable after measuring memory and cold-start overhead.
RIZZLER_PREWARM=0

# V11 Phase 4: opt-in AES-GCM memory; separate independent encryption key.
RIZZLER_MEMORY_ENABLED=0
# RIZZLER_MEMORY_ROOT=/var/lib/rizzler/private_memory
# RIZZLER_MEMORY_KEY=USE_AN_INDEPENDENT_SECRET_AT_LEAST_32_CHARS

# V11 Phase 5: opt-in encrypted, owner-scoped visual analysis.
RIZZLER_VISUAL_ENABLED=0
# RIZZLER_VISUAL_ROOT=/var/lib/rizzler/visuals
# RIZZLER_VISUAL_KEY=INDEPENDENT_RANDOM_32PLUS_BYTE_SECRET

# Full-document PDF ingestion uses the existing separate visual encryption key.
# No hard PDF file-size or page-count cap. Provision encrypted/persistent storage.
# RIZZLER_PDF_ROOT=/var/lib/rizzler/visuals/pdfs
# Configure ClamAV StreamMaxLength and disk capacity for your expected PDFs.

# V11 Phase 6 — bounded background jobs; queued document work remains on disk.
RIZZLER_PDF_MAX_ACTIVE=2
# OPTIONAL conservative daily Gemini request admission (across API+worker
# only when all processes share the same durable root/database).
# RIZZLER_AI_DAILY_BUDGET_USD=25
# RIZZLER_AI_RESERVATION_PER_CALL_USD=0.10
# RIZZLER_AI_BUDGET_ROOT=/var/lib/rizzler
# These are conservative internal reservations, NOT actual Google charges.
# Independently configure Google billing alerts and quota protections.

# V11 Phase 6 — opt-in persistent owner-scoped API rate admission.
# All API and Work replicas must share the same durable SQLite filesystem.
# RIZZLER_ADMISSION_ENABLED=1
# RIZZLER_ADMISSION_SECRET=THIRD_PARTY_INDEPENDENT_32PLUS_BYTE_SECRET
# RIZZLER_ADMISSION_ROOT=/var/lib/rizzler
# RIZZLER_RATE_STANDARD_PER_MIN=1200
# RIZZLER_RATE_EXPENSIVE_PER_MIN=90
# RIZZLER_RATE_UPLOAD_PER_MIN=3600
# RIZZLER_RATE_WORK_PER_MIN=60
# RIZZLER_RATE_CONNECT_PER_MIN=90
# This is a 60-second fixed-window per-owner limiter, not a WAF, IP limiter,
# global Gemini quota, or PDF page/file size restriction. Tune to measured traffic.
